{
  "name": "SeoTask",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "default": "On-Page"
    },
    "target_page": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "In Progress",
        "Done"
      ],
      "default": "Pending"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "keyword": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "company_id"
  ]
}