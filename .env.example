# Neon Managed Auth project URL (public endpoint; not a secret).
VITE_NEON_AUTH_URL=https://your-neon-auth-endpoint

# Neon Data API endpoint (public endpoint; access is controlled by auth and row-level security).
VITE_NEON_DATA_API_URL=https://your-neon-data-api-endpoint

# Direct, unpooled PostgreSQL connection string used only by the local migration script.
# Never expose this variable to browser code or commit a real connection string.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Email that will be bootstrapped as the first Webofolio workspace administrator.
INITIAL_ADMIN_EMAIL=admin@example.com

# Server-only Resend email configuration used by the scheduled Neon reminder function.
# Set these on the Neon Function deployment, never as VITE_ variables.
RESEND_API_KEY=
EMAIL_FROM=Webofolio Reminders <no-reply@example.com>
